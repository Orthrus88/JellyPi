[Unit]
Description=Normalize English subtitle sidecars for Jellyfin clients
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/jellypi-subtitle-sidecars
ExecStart=/usr/local/sbin/jellypi-normalize-subtitle-sidecars.py --status /var/lib/jellypi/subtitle-sidecars.json
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=10
