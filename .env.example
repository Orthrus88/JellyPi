# Copy this file to .env and adjust it for your Pi.
TZ=America/Chicago
PUID=1000
PGID=1000

# Large disk mounted on the Pi. It will contain Movies, TV, Downloads, and
# encoder state. Keep application configuration on the microSD by default.
MEDIA_ROOT=/srv/media
CONFIG_ROOT=/srv/jellypi/config

# Optional services. Leave blank for the standard torrent-only stack. Use a
# comma-separated list such as "usenet,audiobooks" to enable both additions.
COMPOSE_PROFILES=
SABNZBD_PORT=8081
RECOVERY_INTERVAL_SECONDS=300
RECOVERY_MIN_FAILURE_AGE_SECONDS=600

# Optional audiobook stack: Audiobookshelf playback, Chaptarr organization,
# and AudioBookRequest requests. The nightly image is temporarily required for
# Chaptarr handoff; pin a stable version here when that integration is released.
AUDIOBOOKSHELF_PORT=13378
CHAPTARR_PORT=8789
AUDIOBOOKREQUEST_PORT=8000
AUDIOBOOKREQUEST_IMAGE=markbeep/audiobookrequest:nightly

# qBittorrent credentials used by the automatic cleanup worker. Set these to
# the credentials configured in qBittorrent's Web UI after its first start.
QBIT_USER=admin
QBIT_PASSWORD=change-me

# Custom OpenVPN filename placed in CONFIG_ROOT/gluetun.
OPENVPN_CUSTOM_CONFIG=/gluetun/custom.conf
OPENVPN_USER=
OPENVPN_PASSWORD=

# Encoder target. Six Mbps H.264/AAC is a practical direct-play baseline for
# remote Roku, Chromecast, smart-TV, and browser playback.
ENCODER_MAX_VIDEO_BITRATE=6000000
ENCODER_CRF=21
ENCODER_PRESET=veryfast
ENCODER_MIN_AGE_SECONDS=900
ENCODER_CPU_LIMIT=2.0
ENCODER_GPU_TIMEOUT_SECONDS=300
ENCODER_CLAIM_TIMEOUT_SECONDS=600
