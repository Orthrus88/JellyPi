# Copy to .env.nvenc on the NVIDIA computer. This directory must expose the
# same Movies, TV, and .jellypi-encoder paths as MEDIA_ROOT on the Pi.
GPU_MEDIA_ROOT=Z:/

PUID=1000
PGID=1000
TZ=America/Chicago
ENCODER_MAX_VIDEO_BITRATE=6000000
ENCODER_MIN_AGE_SECONDS=900
ENCODER_GPU_TIMEOUT_SECONDS=300
ENCODER_CLAIM_TIMEOUT_SECONDS=600
NVENC_PRESET=p4
NVENC_CQ=23
